# =============================================================================
# .env.example — copy to `.env` and adjust. Committed as a template ONLY.
# Contains NO real secrets. `make setup` copies this to .env if absent.
# Never commit a real .env (it is git-ignored).
# =============================================================================

# --- Django ------------------------------------------------------------------
# Generate a strong random value for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-insecure-change-me
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database (PostGIS) ------------------------------------------------------
# The db service reads POSTGRES_* ; the app reads DATABASE_URL. Keep them
# consistent (same user / password / db / host / port).
POSTGRES_DB=rooftop
POSTGRES_USER=rooftop
POSTGRES_PASSWORD=rooftop
DATABASE_URL=postgis://rooftop:rooftop@db:5432/rooftop

# --- Redis (Celery broker + result backend) ----------------------------------
REDIS_URL=redis://redis:6379/0

# --- Celery ------------------------------------------------------------------
CELERY_QUEUES=orchestration,cpu-heavy

# --- Storage abstraction -----------------------------------------------------
# filesystem (default, shared media volume) or s3 (MinIO/S3, profile storage-s3)
STORAGE_BACKEND=filesystem

# --- Frontend ----------------------------------------------------------------
# Base URL the SPA uses to reach the API (browser-side).
VITE_API_URL=http://localhost:8000/api

# --- Runtime toggles (optional) ----------------------------------------------
# api runs migrations on startup when set to 1.
RUN_MIGRATIONS=1
# Set to 1 to collect static assets on startup (prod-style).
RUN_COLLECTSTATIC=0

# --- OPTIONAL profiles (placeholders; services not in base compose) ----------
# S3 / MinIO (profile storage-s3) — only when STORAGE_BACKEND=s3:
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_STORAGE_BUCKET_NAME=rooftop
# AWS_S3_ENDPOINT_URL=http://minio:9000
# MLflow (profile mlops):
# MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db
# Observability (profile observability):
# GF_SECURITY_ADMIN_PASSWORD=admin
