# =============================================================================
# .dockerignore — keep build context small and reproducible.
# Large artifacts, virtualenvs, notebooks and VCS metadata never enter images.
# =============================================================================

# --- VCS / CI ----------------------------------------------------------------
.git
.gitignore
.github/

# --- Large model / data artifacts (DEC-06) -----------------------------------
unet_buildings.keras
sr_training_30.zip
*.keras
*.h5
*.pb
*.zip
!ml/tests/fixtures/ci_unet.keras

# --- Notebooks (not needed at runtime) ---------------------------------------
*.ipynb
notebook final segmentation.ipynb

# --- Python caches / virtualenvs ---------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.venv-ml/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Node / frontend build output --------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
.vite/

# --- Runtime / user data -----------------------------------------------------
media/
*.log
logs/

# --- Env / secrets -----------------------------------------------------------
.env
*.env
!.env.example

# --- OS / editor -------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Docs / infra not needed inside app images -------------------------------
docs/
